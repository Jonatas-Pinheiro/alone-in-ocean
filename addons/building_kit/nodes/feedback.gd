class_name PKFeedback
extends Node
## Sounds of the build nodes (place, refuse, demolish, upgrade, repair, rotate). The build
## systems make one by themselves; replace the streams, change the volume, or turn it off
## with [member enabled]. The default sounds are generated by [code]tools/gen_sounds.py[/code].

@export var enabled := true
@export_range(-40.0, 6.0, 0.5) var volume_db := -6.0
## Audio bus of the sounds.
@export var bus: StringName = &"Master"
@export var sounds := {
	&"place": preload("res://addons/building_kit/sounds/place.wav"),
	&"refuse": preload("res://addons/building_kit/sounds/refuse.wav"),
	&"demolish": preload("res://addons/building_kit/sounds/demolish.wav"),
	&"upgrade": preload("res://addons/building_kit/sounds/upgrade.wav"),
	&"repair": preload("res://addons/building_kit/sounds/repair.wav"),
	&"rotate": preload("res://addons/building_kit/sounds/rotate.wav"),
}
## Several sounds of one kind in the same frame (a drag of 30 fences) play once.
var _played_frame := {}
var _players: Array[AudioStreamPlayer] = []


func play(kind: StringName, pitch := 1.0) -> void:
	if not enabled or not sounds.has(kind) or sounds[kind] == null or not is_inside_tree():
		return
	if DisplayServer.get_name() == "headless":
		return  # servers and test runs: no audio device
	var frame := Engine.get_process_frames()
	if _played_frame.get(kind, -1) == frame:
		return
	_played_frame[kind] = frame
	var player := _free_player()
	player.stream = sounds[kind]
	player.volume_db = volume_db
	player.pitch_scale = pitch * randf_range(0.95, 1.05)
	player.play()


func _free_player() -> AudioStreamPlayer:
	for player in _players:
		if not player.playing:
			return player
	var player := AudioStreamPlayer.new()
	player.bus = bus
	add_child(player)
	_players.append(player)
	return player
